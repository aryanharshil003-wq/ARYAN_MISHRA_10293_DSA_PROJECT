BT 1 0 0 1 0 130.5 Tm /F3 7.1 Tf 8.6 TL (061          return null;) Tj T* (062      }) Tj T* (063  ) Tj T* (064      // ---------- File handling ----------) Tj T* (065      // Reads contacts.txt \(one contact per line: name,phone,email\).) Tj T* (066      static void loadFromFile\(\) {) Tj T* (067          File file = new File\(FILE\);) Tj T* (068          if \(!file.exists\(\)\) {) Tj T* (069              return;                       // no file yet: start with an empty directory) Tj T* (070          }) Tj T* (071          try {) Tj T* (072              BufferedReader reader = new BufferedReader\(new FileReader\(file\)\);) Tj T* (073              String line;) Tj T* (074              while \(\(line = reader.readLine\(\)\) != null\) {) Tj T* (075                  String[] parts = line.split\(","\);) Tj T* (076                  if \(parts.length == 3\) {) Tj T* ET
