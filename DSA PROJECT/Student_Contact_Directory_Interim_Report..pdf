BT 1 0 0 1 0 508.9 Tm /F3 7.1 Tf 8.6 TL (001  import java.io.*;) Tj T* (002  import java.util.*;) Tj T* (003  ) Tj T* (004  public class ContactDirectory {) Tj T* (005  ) Tj T* (006      // ---------- Contact: one student contact ----------) Tj T* (007      static class Contact {) Tj T* (008          private String name;) Tj T* (009          private String phone;) Tj T* (010          private String email;) Tj T* (011  ) Tj T* (012          Contact\(String name, String phone, String email\) {) Tj T* (013              this.name = name;) Tj T* (014              this.phone = phone;) Tj T* (015              this.email = email;) Tj T* (016          }) Tj T* (017  ) Tj T* (018          String getName\(\) { return name; }) Tj T* (019          String getPhone\(\) { return phone; }) Tj T* (020          String getEmail\(\) { return email; }) Tj T* (021          void setPhone\(String phone\) { this.phone = phone; }) Tj T* (022  ) Tj T* (023          // Printed as: name | phone | email) Tj T* (024          public String toString\(\) {) Tj T* (025              return name + " | " + phone + " | " + email;) Tj T* (026          }) Tj T* (027      }) Tj T* (028  ) Tj T* (029      // ---------- Data ----------) Tj T* (030      static ArrayList<Contact> contacts = new ArrayList<>\(\);         // all contacts) Tj T* (031      static HashMap<String, Contact> phoneMap = new HashMap<>\(\);     // key = phone number) Tj T* (032      static final String FILE = "contacts.txt";) Tj T* (033      static Scanner sc = new Scanner\(System.in\);) Tj T* (034  ) Tj T* (035      // Prints a message and reads one line from the user.) Tj T* (036      static String read\(String message\) {) Tj T* (037          System.out.print\(message\);) Tj T* (038          return sc.nextLine\(\).trim\(\);) Tj T* (039      }) Tj T* (040  ) Tj T* (041      // A valid phone number has exactly 10 digits.) Tj T* (042      static boolean isValidPhone\(String phone\) {) Tj T* (043          if \(phone.length\(\) != 10\) {) Tj T* (044              return false;) Tj T* (045          }) Tj T* (046          for \(int i = 0; i < phone.length\(\); i++\) {) Tj T* (047              if \(!Character.isDigit\(phone.charAt\(i\)\)\) {) Tj T* (048                  return false;) Tj T* (049              }) Tj T* (050          }) Tj T* (051          return true;) Tj T* (052      }) Tj T* (053  ) Tj T* (054      // Linear search by full name \(ignores upper/lower case\). Returns null if not found.) Tj T* (055      static Contact findByName\(String name\) {) Tj T* (056          for \(Contact c : contacts\) {) Tj T* (057              if \(c.getName\(\).equalsIgnoreCase\(name\)\) {) Tj T* (058                  return c;) Tj T* (059              }) Tj T* (060          }) Tj T* ET
